#
# CoA Wrath of the Lich King Content Pack Configuration
#

[worldserver]

#
# CoAWotLK.Enable
#     Description: Enable Wrath of the Lich King expansion pack.
#                  When enabled, WotLK content occupies its layout level band up to MaxPlayerLevel.
#                  When disabled, WotLK content is locked/inaccessible to normal players.
#     Default:     1 - Enabled
#                  0 - Disabled
#
CoAWotLK.Enable = 1
